generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  PENTESTER
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ContactType {
  PHONE
  EMAIL
  ADDRESS
  PERSON
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
  ARCHIVED
}

enum AssignmentRole {
  LEAD
  MEMBER
}

enum AssetType {
  IP
  DOMAIN
  URL
  SUBNET
  HOST
  APPLICATION
  EMAIL
  OTHER
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AgentConnectionType {
  SSH_PASSWORD
  SSH_KEY
  API_KEY
  BEARER_TOKEN
  CUSTOM_HEADERS
  HTTP
  SIMULATOR
}

enum AgentStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  CONFIRMED
  FALSE_POSITIVE
  ACCEPTED
  REMEDIATED
  CLOSED
}

enum ReportFormat {
  PDF
  DOCX
}

enum ReportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  JOB
  CONTRACT
  FINDING
  SYSTEM
}

enum AiProvider {
  OPENAI
  AZURE_OPENAI
  ANTHROPIC
  OLLAMA
  CUSTOM
}

// ---------------------------------------------------------------------------
// Organization & contacts
// ---------------------------------------------------------------------------

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  status      OrganizationStatus @default(ACTIVE)
  website     String?
  industry    String?
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  contacts      OrganizationContact[]
  users         User[]
  contracts     Contract[]
  agents        ExecutionArm[]
  aiEndpoints   AiEndpoint[]
  activities    Activity[]
  findings      Finding[]
  auditLogs     AuditLog[]
  notifications Notification[]
  reports       Report[]
  toolTemplates ToolTemplate[]

  @@index([status])
  @@index([deletedAt])
}

model OrganizationContact {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  type           ContactType
  label          String
  value          String
  personName     String?
  personRole     String?
  isPrimary      Boolean     @default(false)
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String?    @db.Uuid
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role
  status          UserStatus @default(ACTIVE)
  mfaEnabled      Boolean    @default(false)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  assignments       ContractAssignment[]
  activities        Activity[]         @relation("ActivityAuthor")
  findings          Finding[]          @relation("FindingAuthor")
  auditLogs         AuditLog[]
  notifications     Notification[]
  reports           Report[]
  uploadedEvidence  Evidence[]

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Contracts, assignments, assets
// ---------------------------------------------------------------------------

model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  code           String
  title          String
  description    String?
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  amount         Decimal        @db.Decimal(14, 2)
  currency       String         @default("USD") @db.VarChar(3)
  status         ContractStatus @default(DRAFT)
  scope          Json           @default("{}")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  ContractAssignment[]
  assets       Asset[]
  activities   Activity[]
  findings     Finding[]
  reports      Report[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([status])
  @@index([deletedAt])
}

model ContractAssignment {
  id         String         @id @default(uuid()) @db.Uuid
  contractId String         @db.Uuid
  userId     String         @db.Uuid
  role       AssignmentRole @default(MEMBER)
  assignedAt DateTime       @default(now())
  assignedBy String?        @db.Uuid
  metadata   Json           @default("{}")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([userId])
}

model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  contractId     String      @db.Uuid
  name           String
  type           AssetType
  value          String
  criticality    Criticality @default(MEDIUM)
  description    String?
  tags           String[]    @default([])
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  contract   Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  activities Activity[]
  findings   Finding[]

  @@index([contractId])
  @@index([organizationId])
  @@index([type])
  @@index([criticality])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Execution arms (remote agents)
// ---------------------------------------------------------------------------

model ExecutionArm {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @db.Uuid
  name                 String
  description          String?
  connectionType       AgentConnectionType
  host                 String?
  port                 Int?
  /// Encrypted JSON blob: { username, password, privateKey, passphrase, apiKey, token, headers, baseUrl }
  encryptedCredentials String
  connectionConfig     Json                @default("{}")
  capabilities         Json                @default("[]")
  status               AgentStatus         @default(UNKNOWN)
  lastCheckedAt        DateTime?
  lastError            String?
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// AI endpoints
// ---------------------------------------------------------------------------

model AiEndpoint {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String?    @db.Uuid
  name              String
  provider          AiProvider @default(CUSTOM)
  baseUrl           String
  model             String
  encryptedApiKey   String?
  isDefault         Boolean    @default(false)
  isActive          Boolean    @default(true)
  extraHeaders      Json       @default("{}")
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// MITRE ATT&CK
// ---------------------------------------------------------------------------

model MitreTactic {
  id          String   @id @default(uuid()) @db.Uuid
  mitreId     String   @unique
  shortName   String   @unique
  name        String
  description String
  sortOrder   Int
  url         String
  metadata    Json     @default("{}")

  techniques MitreTechnique[]
  activities Activity[]

  @@index([sortOrder])
}

model MitreTechnique {
  id             String   @id @default(uuid()) @db.Uuid
  mitreId        String
  name           String
  description    String
  isSubtechnique Boolean  @default(false)
  parentMitreId  String?
  url            String
  platforms      String[] @default([])
  tacticId       String   @db.Uuid
  metadata       Json     @default("{}")

  tactic     MitreTactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  activities Activity[]
  findings   Finding[]

  @@unique([mitreId, tacticId])
  @@index([mitreId])
  @@index([tacticId])
  @@index([parentMitreId])
  @@index([isSubtechnique])
}

// ---------------------------------------------------------------------------
// Tool templates
// ---------------------------------------------------------------------------

model ToolTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  slug           String
  name           String
  tool           String
  description    String
  command        String
  isBuiltin      Boolean @default(false)
  timeoutSec     Int     @default(300)
  metadata       Json    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@unique([organizationId, slug])
  @@index([tool])
}

// ---------------------------------------------------------------------------
// Activities (jobs / scans / work items)
// ---------------------------------------------------------------------------

model Activity {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  contractId       String    @db.Uuid
  assetId          String    @db.Uuid
  authorId         String    @db.Uuid
  executionArmId   String?   @db.Uuid
  toolTemplateId   String?   @db.Uuid
  mitreTacticId    String?   @db.Uuid
  mitreTechniqueId String?   @db.Uuid
  title            String
  tool             String
  command          String?
  pythonCode       String?
  status           JobStatus @default(QUEUED)
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Full structured tool output, parsed findings, stdout/stderr, timing
  result           Json      @default("{}")
  errorMessage     String?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset        Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  author       User            @relation("ActivityAuthor", fields: [authorId], references: [id])
  executionArm ExecutionArm?   @relation(fields: [executionArmId], references: [id], onDelete: SetNull)
  toolTemplate ToolTemplate?   @relation(fields: [toolTemplateId], references: [id], onDelete: SetNull)
  tactic       MitreTactic?    @relation(fields: [mitreTacticId], references: [id], onDelete: SetNull)
  technique    MitreTechnique? @relation(fields: [mitreTechniqueId], references: [id], onDelete: SetNull)
  findings     Finding[]

  @@index([organizationId, contractId])
  @@index([assetId])
  @@index([status])
  @@index([authorId])
  @@index([mitreTacticId, mitreTechniqueId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Findings & evidence
// ---------------------------------------------------------------------------

model Finding {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  contractId       String          @db.Uuid
  assetId          String?         @db.Uuid
  activityId       String?         @db.Uuid
  authorId         String          @db.Uuid
  mitreTechniqueId String?         @db.Uuid
  title            String
  description      String
  severity         FindingSeverity
  status           FindingStatus   @default(OPEN)
  cvss             Decimal?        @db.Decimal(3, 1)
  cwe              String?
  recommendation   String?
  references       Json            @default("[]")
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset        Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  activity     Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  author       User            @relation("FindingAuthor", fields: [authorId], references: [id])
  technique    MitreTechnique? @relation(fields: [mitreTechniqueId], references: [id], onDelete: SetNull)
  evidence     Evidence[]

  @@index([organizationId, contractId])
  @@index([severity, status])
  @@index([deletedAt])
}

model Evidence {
  id             String   @id @default(uuid()) @db.Uuid
  findingId      String   @db.Uuid
  uploadedById   String   @db.Uuid
  filename       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  checksumSha256 String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([findingId])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contractId     String       @db.Uuid
  generatedById  String       @db.Uuid
  title          String
  format         ReportFormat
  status         ReportStatus @default(QUEUED)
  storagePath    String?
  errorMessage   String?
  options        Json         @default("{}")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  generatedBy  User         @relation(fields: [generatedById], references: [id])

  @@index([contractId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType @default(INFO)
  title          String
  body           String
  link           String?
  readAt         DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
}
