# =============================================================================
# RedOps Manager — environment template
# Copy to .env and adjust. NEVER commit real secrets.
# =============================================================================

# --- Core ---
NODE_ENV=development
APP_NAME=RedOps Manager
APP_URL=http://localhost:3000
API_PORT=4000
API_PREFIX=api/v1

# --- PostgreSQL ---
POSTGRES_USER=redops
POSTGRES_PASSWORD=redops_change_me
POSTGRES_DB=redops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://redops:redops_change_me@postgres:5432/redops?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Encryption (AES-256-GCM). 64 hex chars = 32 bytes. ---
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=RedOps Manager

# --- Seed admin (used only by prisma seed) ---
SEED_ADMIN_EMAIL=admin@redops.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!

# --- Files ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
